{
  "name": "homepage",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-auto": "9.0.0",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/load-config": "0.2.3",
    "@types/node": "26.6.6",
    "autoprefixer": "10.7.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "eslint-plugin-unicorn": "80.0.0",
    "globals": "17.14.0",
    "postcss": "8.5.33",
    "postcss-html": "2.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "stylelint": "18.0.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "41.0.0",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@tanstack/svelte-query": "6.4.4",
    "front-matter": "4.0.2",
    "marked": "18.2.1"
  },
  "exports": {
    "./package.json": "./package.json",
    "./css/css-reset.css": "./package/css/css-reset.css",
    "./css/global.css": "./package/css/global.css",
    "./css/landing-card-animation.css": "./package/css/landing-card-animation.css",
    "./ts/math": {
      "types": "./package/ts/math.d.ts",
      "default": "./package/ts/math.js"
    }
  },
  "files": [
    "package"
  ],
  "typesVersions": {
    ">4.0": {
      "ts/math": [
        "./package/ts/math.d.ts"
      ]
    }
  }
}
