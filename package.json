{
  "name": "homepage",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/kit": "2.65.1",
    "@types/node": "25.9.3",
    "autoprefixer": "10.5.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.19.0",
    "eslint-plugin-unicorn": "66.0.0",
    "globals": "17.6.0",
    "postcss": "8.5.15",
    "postcss-html": "1.8.1",
    "prettier": "3.8.4",
    "prettier-plugin-svelte": "4.1.1",
    "stylelint": "17.13.0",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-standard": "40.0.0",
    "svelte": "5.56.3",
    "svelte-check": "4.6.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.0.16"
  },
  "type": "module",
  "dependencies": {
    "@tanstack/svelte-query": "6.1.34",
    "front-matter": "4.0.2",
    "marked": "18.0.5"
  },
  "exports": {
    "./package.json": "./package.json",
    "./css/css-reset.css": "./package/css/css-reset.css",
    "./css/global.css": "./package/css/global.css",
    "./css/landing-card-animation.css": "./package/css/landing-card-animation.css",
    "./ts/math": {
      "types": "./package/ts/math.d.ts",
      "default": "./package/ts/math.js"
    }
  },
  "files": [
    "package"
  ],
  "typesVersions": {
    ">4.0": {
      "ts/math": [
        "./package/ts/math.d.ts"
      ]
    }
  }
}
