    "eslint-plugin-svelte": "^3.13.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^16.5.0",
    "postcss": "^8.4.49",
    "postcss-html": "^1.7.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "^16.11.0",
    "stylelint-config-html": "^1.1.0",
